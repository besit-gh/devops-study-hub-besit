# Скопируйте файл в backend/.env и укажите свой ключ OpenAI API
OPENAI_API_KEY=your_openai_api_key_here

# Необязательно: модель OpenAI (по умолчанию gpt-4.1-mini)
# OPENAI_MODEL=gpt-4.1-mini

# Необязательно: разрешённые CORS-источники через запятую
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000
